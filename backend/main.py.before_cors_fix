class SearchRequest(BaseModel):
    question: str = Field(min_length=2, max_length=2000)
    top_k: int = Field(default=3, ge=1, le=10)


@app.post("/search/{document_id}")
def search_document(document_id: str, request: SearchRequest):

    if not document_id.isalnum():
        raise HTTPException(
            status_code=400,
            detail="Invalid document ID."
        )

    try:
        model, collection = get_embedding_resources()

        if collection.count() == 0:
            raise HTTPException(
                status_code=404,
                detail="No document embeddings found. Process the document first."
            )

        # Convert the user's question into a vector
        question_embedding = model.encode(
            request.question,
            normalize_embeddings=True
        ).tolist()

        # Search only inside the selected document
        results = collection.query(
            query_embeddings=[question_embedding],
            n_results=min(request.top_k, collection.count()),
            where={"document_id": document_id},
            include=["documents", "metadatas", "distances"]
        )

        documents = results.get("documents", [[]])[0]
        metadatas = results.get("metadatas", [[]])[0]
        distances = results.get("distances", [[]])[0]

        if not documents:
            raise HTTPException(
                status_code=404,
                detail="No embeddings found for this document. Generate embeddings first."
            )

        matches = []

        for text, metadata, distance in zip(
            documents, metadatas, distances
        ):
            similarity = max(0.0, min(1.0, 1.0 - distance))

            matches.append({
                "chunk_id": metadata["chunk_id"],
                "filename": metadata["filename"],
                "page": metadata["page"] or None,
                "similarity": round(similarity, 4),
                "text": text
            })

        return {
            "status": "success",
            "document_id": document_id,
            "question": request.question,
            "total_results": len(matches),
            "results": matches
        }

    except HTTPException:
        raise

    except Exception as exc:
        print(f"Semantic search error: {exc}")

        raise HTTPException(
            status_code=500,
            detail="Semantic search failed. Check the backend terminal."
        ) from exc


