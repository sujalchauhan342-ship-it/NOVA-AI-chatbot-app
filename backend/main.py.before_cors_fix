def wikipedia_plugin(query: str, max_results: int = 5):
    try:
        query = query.strip()

        if not query:
            return {
                "status": "error",
                "message": "Wikipedia search query cannot be empty."
            }

        max_results = max(1, min(int(max_results), 8))

        params = {
            "action": "query",
            "generator": "search",
            "gsrsearch": query,
            "gsrlimit": max_results,
            "prop": "extracts",
            "exintro": 1,
            "explaintext": 1,
            "exsentences": 5,
            "inprop": "url",
            "format": "json",
            "formatversion": 2
        }

        url = (
            "https://en.wikipedia.org/w/api.php?"
            + urlencode(params)
        )

        with urlopen(url, timeout=15) as response:
            data = json.loads(response.read().decode("utf-8"))

        pages = data.get("query", {}).get("pages", [])

        results = []

        for page in pages:
            results.append({
                "title": page.get("title", ""),
                "url": page.get("fullurl", ""),
                "extract": page.get("extract", "")
            })

        return {
            "status": "success",
            "query": query,
            "results": results,
            "message": (
                "Wikipedia articles retrieved successfully."
                if results else "No Wikipedia articles found."
            )
        }

    except Exception as e:
        print(f"Wikipedia Plugin Error: {e}")

        return {
            "status": "error",
            "message": "Wikipedia service is temporarily unavailable."
        }


