@app.post("/process/{document_id}")
def process_document(document_id: str):

    if not document_id.isalnum():
        raise HTTPException(
            status_code=400,
            detail="Invalid document ID."
        )

    matching_files = [
        file for file in UPLOAD_DIR.iterdir()
        if file.is_file() and file.name.startswith(document_id + "_")
    ]

    if not matching_files:
        raise HTTPException(
            status_code=404,
            detail="Document not found."
        )

    file_path = matching_files[0]
    extension = file_path.suffix.lower()

    try:
        pages = extract_text(file_path, extension)

        full_text = "\
\
".join(
            item["text"] for item in pages
        )

        if not full_text.strip():
            raise HTTPException(
                status_code=422,
                detail="No readable text found in the document."
            )

        return {
            "status": "success",
            "document_id": document_id,
            "filename": file_path.name.split("_", 1)[1],
            "total_pages": len(pages) if extension == ".pdf" else None,
            "total_characters": len(full_text),
            "extracted_text": pages
        }

    except HTTPException:
        raise

    except Exception as exc:
        print(f"Document extraction error: {exc}")

        raise HTTPException(
            status_code=500,
            detail="Could not extract document text."
        ) from exc


