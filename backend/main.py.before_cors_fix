@app.post("/chunk/{document_id}")
def chunk_document(document_id: str):

    if not document_id.isalnum():
        raise HTTPException(
            status_code=400,
            detail="Invalid document ID."
        )

    matching_files = [
        file for file in UPLOAD_DIR.iterdir()
        if file.is_file() and file.name.startswith(document_id + "_")
    ]

    if not matching_files:
        raise HTTPException(
            status_code=404,
            detail="Document not found."
        )

    file_path = matching_files[0]

    try:
        pages = extract_text(file_path, file_path.suffix.lower())

        all_chunks = []

        for page in pages:
            page_chunks = create_chunks(page["text"])

            for index, chunk in enumerate(page_chunks, start=1):
                all_chunks.append({
                    "chunk_id": len(all_chunks) + 1,
                    "page": page["page"],
                    "text": chunk
                })

        if not all_chunks:
            raise HTTPException(
                status_code=422,
                detail="No chunks could be generated from this document."
            )

        return {
            "status": "success",
            "document_id": document_id,
            "filename": file_path.name.split("_", 1)[1],
            "total_chunks": len(all_chunks),
            "chunk_size": 500,
            "chunk_overlap": 100,
            "chunks": all_chunks
        }

    except HTTPException:
        raise

    except Exception as exc:
        print(f"Chunking error: {exc}")
        raise HTTPException(
            status_code=500,
            detail="Could not create document chunks."
        ) from exc


