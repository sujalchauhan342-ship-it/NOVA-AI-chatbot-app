class RAGChatRequest(BaseModel):
    question: str = Field(min_length=1, max_length=10000)
    top_k: int = Field(default=3, ge=1, le=10)


@app.post("/chat-with-doc/{document_id}")
def chat_with_document(document_id: str, request: RAGChatRequest):

    if not document_id.isalnum():
        raise HTTPException(
            status_code=400,
            detail="Invalid document ID."
        )

    if client is None:
        raise HTTPException(
            status_code=503,
            detail="Groq API key is not configured."
        )

    try:
        # 1. Load embedding model and ChromaDB
        model, collection = get_embedding_resources()

        # 2. Convert question into an embedding
        question_embedding = model.encode(
            request.question,
            normalize_embeddings=True
        ).tolist()

        # 3. Retrieve relevant chunks from the selected document
        results = collection.query(
            query_embeddings=[question_embedding],
            n_results=request.top_k,
            where={"document_id": document_id},
            include=["documents", "metadatas", "distances"]
        )

        retrieved_texts = results.get("documents", [[]])[0]
        metadatas = results.get("metadatas", [[]])[0]

        if not retrieved_texts:
            raise HTTPException(
                status_code=404,
                detail="No document chunks found. Generate embeddings first."
            )

        # 4. Build context with source information
        context_parts = []
        sources = []

        for text, metadata in zip(retrieved_texts, metadatas):
            page = metadata.get("page", 0)

            source = {
                "filename": metadata.get("filename"),
                "page": page or None,
                "chunk_id": metadata.get("chunk_id")
            }

            context_parts.append(
                f"Source: {source['filename']}, "
                f"Page: {source['page']}, "
                f"Chunk: {source['chunk_id']}\n{text}"
            )

            sources.append(source)

        context = "\n\n".join(context_parts)

        # 5. Send retrieved context and question to Groq
        messages = [
            {
                "role": "system",
                "content": (
                    "You are a document-based AI assistant. "
                    "Answer the user's question using the supplied document "
                    "context. Do not invent facts or use outside knowledge "
                    "to fill gaps. If the answer is not present in the "
                    "context, clearly say that the uploaded document does "
                    "not provide enough information. "
                    "When possible, mention the relevant page number."
                )
            },
            {
                "role": "user",
                "content": (
                    f"DOCUMENT CONTEXT:\n{context}\n\n"
                    f"USER QUESTION:\n{request.question}\n\n"
                    "Answer clearly using the document context."
                )
            }
        ]

        result = client.chat.completions.create(
            model=GROQ_MODEL,
            messages=messages,
            temperature=0.3,
            max_tokens=2048
        )

        answer = result.choices[0].message.content or ""

        return {
            "status": "success",
            "document_id": document_id,
            "question": request.question,
            "answer": answer,
            "sources": sources,
            "model": GROQ_MODEL
        }

    except HTTPException:
        raise

    except Exception as exc:
        print(f"RAG chat error: {exc}")

        raise HTTPException(
            status_code=502,
            detail="RAG chat failed. Check the backend terminal."
        ) from exc
