@app.post("/chat")
def chat(request: ChatRequest):

    if client is None:
        raise HTTPException(
            status_code=503,
            detail="Groq API key is not configured."
        )

    enabled_plugins = set(request.enabled_plugins or [])

    # Only expose tools that the user has enabled.
    enabled_tools = [
        tool for tool in AVAILABLE_TOOLS
        if tool["function"]["name"] in enabled_plugins
    ]

    system_prompt = (
        "You are a helpful AI assistant. "
        "Give clear, accurate answers in English. "
    )

    if "calculator" in enabled_plugins:
        system_prompt += (
            "Use the calculator tool whenever mathematical calculations "
            "are required. Never guess calculation results. "
        )

    if "weather" in enabled_plugins:
        system_prompt += (
            "Use the weather tool for current weather and forecast questions. "
            "Do not invent live weather information. "
        )


    if "web_search" in enabled_plugins:
        system_prompt += (
            "Use the web_search tool when the user asks for current information, "
            "latest news, recent events, or information that requires internet search. "
            "Base your answer on the returned search results. Include source URLs "
            "when relevant. Never invent search results. "
        )

    if "wikipedia" in enabled_plugins:
        system_prompt += (
            "Use the wikipedia tool for general knowledge and educational "
            "questions when Wikipedia information is appropriate. "
            "Base your answer on retrieved articles and include article "
            "titles or URLs when relevant. Never invent article content. "
        )

    if not enabled_tools:
        system_prompt += "No plugins are enabled. Do not call any plugin tools."

    messages = [
        {
            "role": "system",
            "content": system_prompt
        }
    ]

    for item in request.history[-10:]:
        messages.append({
            "role": item.role,
            "content": item.content
        })

    messages.append({
        "role": "user",
        "content": request.message
    })

    used_plugins = []

    try:

        result = client.chat.completions.create(
            model=GROQ_MODEL,
            messages=messages,
            **({"tools": enabled_tools, "tool_choice": "auto"} if enabled_tools else {}),
            temperature=0.2,
            max_tokens=2048
        )

        for _ in range(5):

            assistant_message = result.choices[0].message
            tool_calls = assistant_message.tool_calls

            if not tool_calls:
                return {
                    "status": "success",
                    "response": assistant_message.content or "",
                    "plugin_used": bool(used_plugins),
                    "plugins": used_plugins
                }

            messages.append({
                "role": "assistant",
                "content": assistant_message.content or "",
                "tool_calls": [
                    {
                        "id": call.id,
                        "type": "function",
                        "function": {
                            "name": call.function.name,
                            "arguments": call.function.arguments
                        }
                    }
                    for call in tool_calls
                ]
            })

            for call in tool_calls:

                function_name = call.function.name

                try:
                    arguments = json.loads(call.function.arguments or "{}")

                    if function_name not in enabled_plugins:
                        tool_result = {
                            "status": "error",
                            "message": f"The {function_name} plugin is disabled."
                        }

                    elif function_name == "calculator":
                        tool_result = calculator_plugin(arguments["expression"])

                    elif function_name == "weather":
                        tool_result = weather_plugin(
                            arguments["location"],
                            arguments.get("forecast_days", 3)
                        )

                    elif function_name == "web_search":
                        tool_result = web_search_plugin(
                            arguments["query"],
                            arguments.get("max_results", 5)
                        )

                    elif function_name == "wikipedia":
                        tool_result = wikipedia_plugin(
                            arguments["query"],
                            arguments.get("max_results", 5)
                        )

                    else:
                        tool_result = {
                            "status": "error",
                            "message": "Unknown plugin."
                        }

                    if (
                        function_name in ("calculator", "weather", "web_search", "wikipedia")
                        and tool_result.get("status") == "success"
                        and function_name not in used_plugins
                    ):
                        used_plugins.append(function_name)

                except Exception as exc:
                    print(f"Plugin execution error ({function_name}): {exc}")
                    tool_result = {
                        "status": "error",
                        "message": "The plugin could not process this request."
                    }

                messages.append({
                    "role": "tool",
                    "tool_call_id": call.id,
                    "content": json.dumps(tool_result)
                })

            # Keep the same enabled-plugin restrictions in every tool round.
            result = client.chat.completions.create(
                model=GROQ_MODEL,
                messages=messages,
                **({"tools": enabled_tools, "tool_choice": "auto"} if enabled_tools else {}),
                temperature=0.2,
                max_tokens=2048
            )

        raise HTTPException(
            status_code=502,
            detail="Maximum plugin execution rounds exceeded."
        )

    except HTTPException:
        raise

    except Exception as exc:

        print(f"Chat/Plugin error: {exc}")

        raise HTTPException(
            status_code=502,
            detail="The AI provider or plugin could not complete the request."
        ) from exc


