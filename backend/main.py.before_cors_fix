def weather_plugin(location: str, forecast_days: int = 3):
    """Fetch current weather and a short forecast using Open-Meteo."""

    location = location.strip()
    forecast_days = max(1, min(int(forecast_days), 3))

    if not location:
        return {"status": "error", "message": "Please provide a city or location."}

    try:
        # Find the coordinates for the requested city.
        geo_params = urlencode({
            "name": location,
            "count": 1,
            "language": "en",
            "format": "json"
        })
        geo_url = "https://geocoding-api.open-meteo.com/v1/search?" + geo_params

        with urlopen(geo_url, timeout=12) as response:
            geo_data = json.loads(response.read().decode("utf-8"))

        places = geo_data.get("results", [])
        if not places:
            return {
                "status": "error",
                "message": f"Location '{location}' was not found. Try a nearby city name."
            }

        place = places[0]
        latitude = place["latitude"]
        longitude = place["longitude"]

        # Fetch current conditions and daily forecast.
        forecast_params = urlencode({
            "latitude": latitude,
            "longitude": longitude,
            "current": (
                "temperature_2m,relative_humidity_2m,apparent_temperature,"
                "precipitation,weather_code,wind_speed_10m"
            ),
            "daily": (
                "weather_code,temperature_2m_max,temperature_2m_min,"
                "precipitation_probability_max"
            ),
            "forecast_days": forecast_days,
            "timezone": "auto"
        })
        forecast_url = "https://api.open-meteo.com/v1/forecast?" + forecast_params

        with urlopen(forecast_url, timeout=12) as response:
            weather_data = json.loads(response.read().decode("utf-8"))

        current = weather_data.get("current", {})
        daily = weather_data.get("daily", {})

        code = current.get("weather_code")
        current_weather = {
            "temperature_c": current.get("temperature_2m"),
            "feels_like_c": current.get("apparent_temperature"),
            "humidity_percent": current.get("relative_humidity_2m"),
            "wind_speed_kmh": current.get("wind_speed_10m"),
            "precipitation_mm": current.get("precipitation"),
            "condition": WEATHER_CODES.get(code, "Unknown")
        }

        forecast = []
        dates = daily.get("time", [])

        for index, date in enumerate(dates):
            daily_code = daily.get("weather_code", [None] * len(dates))[index]
            forecast.append({
                "date": date,
                "condition": WEATHER_CODES.get(daily_code, "Unknown"),
                "temperature_max_c": daily.get("temperature_2m_max", [None] * len(dates))[index],
                "temperature_min_c": daily.get("temperature_2m_min", [None] * len(dates))[index],
                "rain_probability_percent": daily.get(
                    "precipitation_probability_max", [None] * len(dates)
                )[index]
            })

        return {
            "status": "success",
            "location": {
                "name": place.get("name"),
                "admin1": place.get("admin1"),
                "country": place.get("country")
            },
            "timezone": weather_data.get("timezone"),
            "current": current_weather,
            "forecast": forecast
        }

    except Exception as exc:
        print(f"Weather plugin error: {exc}")
        return {
            "status": "error",
            "message": "Weather service is temporarily unavailable. Please try again."
        }



