import chromadb
from sentence_transformers import SentenceTransformer

CHROMA_DIR = Path(__file__).resolve().parent / "chroma_db"
EMBEDDING_MODEL_NAME = "sentence-transformers/all-MiniLM-L6-v2"

_embedding_model = None
_chroma_client = None
_chroma_collection = None


def get_embedding_resources():
    global _embedding_model
    global _chroma_client
    global _chroma_collection

    if _embedding_model is None:
        print("Loading embedding model...")
        _embedding_model = SentenceTransformer(EMBEDDING_MODEL_NAME)

    if _chroma_client is None:
        CHROMA_DIR.mkdir(parents=True, exist_ok=True)

        _chroma_client = chromadb.PersistentClient(
            path=str(CHROMA_DIR)
        )

        _chroma_collection = _chroma_client.get_or_create_collection(
            name="document_chunks",
            metadata={"hnsw:space": "cosine"}
        )

    return _embedding_model, _chroma_collection


# --------------------------------------------------
# GENERATE AND STORE DOCUMENT EMBEDDINGS
# --------------------------------------------------

@app.post("/embed/{document_id}")
def embed_document(document_id: str):

    if not document_id.isalnum():
        raise HTTPException(
            status_code=400,
            detail="Invalid document ID."
        )

    matching_files = [
        file for file in UPLOAD_DIR.iterdir()
        if file.is_file() and file.name.startswith(document_id + "_")
    ]

    if not matching_files:
        raise HTTPException(
            status_code=404,
            detail="Document not found."
        )

    file_path = matching_files[0]

    try:
        # Extract document text
        pages = extract_text(file_path, file_path.suffix.lower())

        # Generate chunks
        all_chunks = []

        for page in pages:
            page_chunks = create_chunks(page["text"])

            for chunk in page_chunks:
                all_chunks.append({
                    "text": chunk,
                    "page": page["page"]
                })

        if not all_chunks:
            raise HTTPException(
                status_code=422,
                detail="No chunks found in the document."
            )

        # Load embedding model and ChromaDB
        model, collection = get_embedding_resources()

        # Generate vectors
        texts = [chunk["text"] for chunk in all_chunks]

        embeddings = model.encode(
            texts,
            normalize_embeddings=True,
            show_progress_bar=False
        )

        # Remove previous embeddings for this document
        collection.delete(
            where={"document_id": document_id}
        )

        # Prepare metadata
        ids = []
        metadatas = []

        for index, chunk in enumerate(all_chunks, start=1):
            ids.append(f"{document_id}_chunk_{index}")

            metadatas.append({
                "document_id": document_id,
                "filename": file_path.name.split("_", 1)[1],
                "chunk_id": index,
                "page": chunk["page"] or 0
            })

        # Store vectors and text in ChromaDB
        collection.add(
            ids=ids,
            embeddings=embeddings.tolist(),
            documents=texts,
            metadatas=metadatas
        )

        return {
            "status": "success",
            "message": "Embeddings generated and stored successfully.",
            "document_id": document_id,
            "filename": file_path.name.split("_", 1)[1],
            "total_chunks": len(all_chunks),
            "embedding_dimensions": len(embeddings[0]),
            "vector_database": "ChromaDB"
        }

    except HTTPException:
        raise

    except Exception as exc:
        print(f"Embedding error: {exc}")

        raise HTTPException(
            status_code=500,
            detail="Could not generate or store embeddings."
        ) from exc


