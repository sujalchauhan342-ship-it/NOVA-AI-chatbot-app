@app.get("/documents")
def get_documents():

    documents = []

    for path in UPLOAD_DIR.iterdir():

        if not path.is_file():
            continue

        if "_" not in path.name:
            continue

        document_id, filename = path.name.split("_", 1)

        documents.append({
            "document_id": document_id,
            "filename": filename,
            "size_bytes": path.stat().st_size,
        })

    return {
        "status": "success",
        "total_documents": len(documents),
        "documents": documents,
    }


